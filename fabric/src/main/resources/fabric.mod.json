{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    {
      "name": "KiriCattus",
      "contact": {
        "homepage": "https://tophatcat.dev",
        "github": "https://github.com/KiriCattus",
        "bsky": "https://bsky.app/profile/tophatcat.dev",
        "curseforge": "https://www.curseforge.com/members/KiriCattus/projects",
        "modrinth": "https://modrinth.com/user/KiriCattus"
      }
    }
  ],
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "license": "${license_url}",
  "icon": "icon.png",
  "entrypoints": {
    "main": [
      "dev.tophatcat.knockknock.KnockKnockFabric"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${discord_url}"
      },
      "update_checker": true
    },
    "mc-publish": {
      "curseforge": "${curseforge_id}",
      "modrinth": "${modrinth_id}",
      "loaders": [
        "fabric"
      ],
      "java_version": [
        "${java_version}"
      ],
      "dependencies": [
        "fabric-api(required){modrinth:P7dR8mSH}{curseforge:306612}"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "java": ">=${java_version}",
    "minecraft": "=${minecraft_version}",
    "fabric-api": "${fabric_api_version}"
  },
  "environment": "*"
}
