# Store and check out repository text as LF on every platform. Windows command
# files are the sole exception below.
* text=auto eol=lf
*.bat text eol=crlf
*.patch text eol=lf
*.java text eol=lf
*.cfg text eol=lf
*.png binary
*.gif binary
*.exe binary
*.dll binary
*.jar binary
*.lzma binary
*.zip binary
*.pyd binary
*.jks binary
